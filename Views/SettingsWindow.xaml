<Window x:Class="ClipCompose.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClipCompose.Core.Localization;assembly=ClipCompose.Core"
        xmlns:v="clr-namespace:ClipCompose.Views"
        Title="{x:Static l:Strings.SettingsTitle}"
        Width="1000" Height="640" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        FontFamily="{x:Static v:UiFont.Family}" FontSize="13">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="DataButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.ButtonClose}" MinWidth="88" Padding="8,2" Click="OnClose" />
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
        <TabControl x:Name="Tabs">
            <TabItem x:Name="TemplatesTab" Header="{x:Static l:Strings.TabTemplates}">
                <v:TemplateEditor x:Name="Editor" Margin="10" />
            </TabItem>

            <TabItem x:Name="HotkeysTab" Header="{x:Static l:Strings.TabHotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
                        <Border x:Name="FirstRunBanner" Background="#E8F1FB" BorderBrush="#9CC3EA" BorderThickness="1" Padding="10,8" Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock Text="{x:Static l:Strings.FirstRunNote}" TextWrapping="Wrap" />
                        </Border>
                        <GroupBox Header="{x:Static l:Strings.SettingsHotkeys}" Padding="8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Static l:Strings.SettingsNormalHotkey}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <v:ShortcutBox x:Name="NormalBox" Grid.Column="1" Height="26" Margin="0,2"
                                                   AutomationProperties.Name="{x:Static l:Strings.SettingsNormalHotkey}" />
                                    <TextBlock x:Name="NormalStatus" Grid.Row="1" Grid.ColumnSpan="2" Foreground="Firebrick" FontSize="12" Margin="0,0,0,6" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="2" Text="{x:Static l:Strings.SettingsFixedHotkey}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <v:ShortcutBox x:Name="FixedBox" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,2"
                                                   AutomationProperties.Name="{x:Static l:Strings.SettingsFixedHotkey}" />
                                    <TextBlock x:Name="FixedStatus" Grid.Row="3" Grid.ColumnSpan="2" Foreground="Firebrick" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{x:Static l:Strings.SettingsHotkeyNote}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static l:Strings.SettingsAutoPaste}" Padding="8" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="NormalAutoPasteBox" Content="{x:Static l:Strings.SettingsNormalAutoPaste}" Margin="0,2" Checked="OnAutoPasteChanged" Unchecked="OnAutoPasteChanged" />
                                <CheckBox x:Name="FixedAutoPasteBox" Content="{x:Static l:Strings.SettingsFixedAutoPaste}" Margin="0,2" Checked="OnAutoPasteChanged" Unchecked="OnAutoPasteChanged" />
                                <TextBlock Text="{x:Static l:Strings.SettingsAutoPasteNote}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </GroupBox>
                        <TextBlock Text="{x:Static l:Strings.SettingsAppliedNote}" Style="{StaticResource Note}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="GeneralTab" Header="{x:Static l:Strings.TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
                        <GroupBox Header="{x:Static l:Strings.SettingsLanguage}" Padding="8">
                            <StackPanel>
                                <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Name"
                                          SelectionChanged="OnLanguageChanged" AutomationProperties.Name="{x:Static l:Strings.SettingsLanguage}" />
                                <TextBlock Text="{x:Static l:Strings.SettingsLanguageNote}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static l:Strings.SettingsData}" Padding="8" Margin="0,10,0,0">
                            <StackPanel>
                                <WrapPanel>
                                    <Button x:Name="ImportButton" Content="{x:Static l:Strings.ButtonImport}" Style="{StaticResource DataButton}" Click="OnImport" />
                                    <Button Content="{x:Static l:Strings.ButtonExport}" Style="{StaticResource DataButton}" Click="OnExport" />
                                    <Button Content="{x:Static l:Strings.ButtonOpenFolder}" Style="{StaticResource DataButton}" Click="OnOpenFolder" />
                                    <Button x:Name="RecoveryButton" Content="{x:Static l:Strings.ButtonRecovery}" Style="{StaticResource DataButton}" Click="OnRecovery" />
                                </WrapPanel>
                                <TextBlock x:Name="DataFolderText" Style="{StaticResource Note}" />
                                <TextBlock Text="{x:Static l:Strings.SettingsDataNote}" Style="{StaticResource Note}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AboutTab" Header="{x:Static l:Strings.TabAbout}">
                <StackPanel Margin="16">
                    <TextBlock Text="ClipCompose" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="#555" />
                    <TextBlock Text="© ja1bus" Margin="0,2,0,0" Foreground="#555" />
                    <Button Content="{x:Static l:Strings.ButtonGuide}" HorizontalAlignment="Left" Padding="10,3" Margin="0,16,0,0" Click="OnGuide" />
                    <!-- 取扱説明書・プライバシーポリシーは Web だけに置き、表示言語に合わせた URL を既定のブラウザーで開く。 -->
                    <TextBlock Margin="0,16,0,0">
                        <Hyperlink Click="OnOpenManual"><Run Text="{x:Static l:Strings.AboutManualLink}" /></Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="OnOpenPrivacy"><Run Text="{x:Static l:Strings.AboutPrivacyLink}" /></Hyperlink>
                    </TextBlock>
                    <!-- ライセンスの全文は同梱の LICENSE をこの画面から表示し、Web だけに頼らない。 -->
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="OnShowLicense" ToolTip="{x:Static l:Strings.AboutLicenseTip}"><Run Text="{x:Static l:Strings.AboutLicenseLink}" /></Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="OnOpenSource"><Run Text="{x:Static l:Strings.AboutSourceLink}" /></Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="OnShowNotices" ToolTip="{x:Static l:Strings.AboutNoticesTip}"><Run Text="{x:Static l:Strings.AboutNoticesLink}" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
