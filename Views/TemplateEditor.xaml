<UserControl x:Class="ClipCompose.Views.TemplateEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ClipCompose.Core.Localization;assembly=ClipCompose.Core"
             xmlns:v="clr-namespace:ClipCompose.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="MinWidth" Value="52" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <DataTemplate DataType="{x:Type v:CategoryRow}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#444" Margin="2,4,2,2" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:TemplateRow}">
            <Grid Margin="16,1,2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="&#xE77F;" FontFamily="{x:Static v:UiFont.Icons}" FontSize="12" Foreground="#2E6DB4"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{x:Static l:Strings.UsesClipboard}"
                           Visibility="{Binding UsesClipboard, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="2" Text="&#xE840;" FontFamily="{x:Static v:UiFont.Icons}" FontSize="13" Foreground="#D9480F"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{x:Static l:Strings.PinnedMark}"
                           Visibility="{Binding Pinned, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <!-- 読み込みに失敗して保存を止めているとき -->
        <Border x:Name="BlockedBanner" DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="1" Padding="10,6"
                Margin="0,0,0,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static l:Strings.ButtonRecovery}" Click="OnRecovery" Margin="8,0,0,0" />
                <TextBlock x:Name="BlockedText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- カテゴリとテンプレート（1 つの一覧） -->
            <DockPanel Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="{x:Static l:Strings.TemplatesHeader}" Style="{StaticResource Header}" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <WrapPanel>
                        <Button x:Name="AddCategoryButton" Content="{x:Static l:Strings.ButtonAddCategory}" Click="OnAddCategory" />
                        <Button x:Name="NewTemplateButton" Content="{x:Static l:Strings.ButtonNewTemplate}" Click="OnNewTemplate" />
                    </WrapPanel>
                    <WrapPanel>
                        <Button x:Name="UpButton" Content="{x:Static l:Strings.ButtonUp}" ToolTip="{x:Static l:Strings.ButtonMoveTip}" Click="OnMoveUp" />
                        <Button x:Name="DownButton" Content="{x:Static l:Strings.ButtonDown}" ToolTip="{x:Static l:Strings.ButtonMoveTip}" Click="OnMoveDown" />
                        <Button x:Name="RenameButton" Content="{x:Static l:Strings.ButtonRename}" ToolTip="{x:Static l:Strings.ButtonRenameTip}" Click="OnRenameCategory" />
                        <Button x:Name="DeleteButton" Content="{x:Static l:Strings.ButtonDelete}" Click="OnDelete" />
                    </WrapPanel>
                    <WrapPanel>
                        <!-- ピンのアイコンは一覧・選択画面と同じ（WPF は絵文字をカラーで描かないためアイコンフォント）。 -->
                        <Button x:Name="PinButton" ToolTip="{x:Static l:Strings.ButtonPinTip}" Click="OnTogglePin"
                                AutomationProperties.Name="{Binding Text, ElementName=PinText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE840;" FontFamily="{x:Static v:UiFont.Icons}" Foreground="#D9480F" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="PinText" Text="{x:Static l:Strings.ButtonPin}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <Grid>
                    <ListBox x:Name="List" SelectionChanged="OnSelected" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnListDoubleClick"
                             AutomationProperties.Name="{x:Static l:Strings.TemplatesHeader}" />
                    <TextBlock x:Name="NoCategoriesText" Text="{x:Static l:Strings.NoCategoriesHint}" Foreground="Gray" TextWrapping="Wrap"
                               Margin="10" VerticalAlignment="Top" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>

            <!-- 編集 -->
            <Grid Grid.Column="1" x:Name="EditorPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EditorStateText" Grid.ColumnSpan="2" Style="{StaticResource Header}" />
                <TextBlock Grid.Row="1" Text="{x:Static l:Strings.EditorName}" VerticalAlignment="Center" Margin="0,0,8,4" />
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Padding="2" TextChanged="OnEditorChanged" />
                <TextBlock Grid.Row="2" Text="{x:Static l:Strings.EditorCategory}" VerticalAlignment="Center" Margin="0,0,8,4" />
                <ComboBox x:Name="EditorCategoryBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" DisplayMemberPath="Name" SelectionChanged="OnEditorChanged" />
                <DockPanel Grid.Row="3" Grid.ColumnSpan="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                        <Button x:Name="InsertVariableButton" DockPanel.Dock="Right" Content="{x:Static l:Strings.EditorInsertVariable}" Click="OnInsertVariable" Margin="8,0,0,0" />
                        <TextBlock Text="{x:Static l:Strings.EditorBody}" VerticalAlignment="Center" />
                        <TextBlock x:Name="UsageText" Foreground="#555" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock x:Name="CountText" Foreground="#555" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </DockPanel>
                    <TextBox x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Yu Gothic UI" FontSize="13" Padding="4"
                             TextChanged="OnEditorChanged" />
                </DockPanel>
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{x:Static l:Strings.EditorVariableHint}" Foreground="#555" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                <DockPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RevertButton" Content="{x:Static l:Strings.ButtonRevert}" Click="OnRevert" MinWidth="80" />
                        <Button x:Name="SaveButton" Content="{x:Static l:Strings.ButtonSave}" Click="OnSave" MinWidth="80" Margin="0,0,0,4" />
                    </StackPanel>
                    <TextBlock x:Name="EditorErrorText" Foreground="Firebrick" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
