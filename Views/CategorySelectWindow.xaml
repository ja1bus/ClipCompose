<Window x:Class="ClipCompose.Views.CategorySelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClipCompose.Core.Localization;assembly=ClipCompose.Core"
        xmlns:v="clr-namespace:ClipCompose.Views"
        Title="ClipCompose" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{x:Static v:UiFont.Family}" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <DataTemplate DataType="{x:Type v:CategoryChoice}">
            <Grid Margin="2,3,4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- チェックはカテゴリ ID に結び付けた値（スクロール・検索で別の行へ移らない）。行の選択中は Space でも切り替える。 -->
                <CheckBox IsChecked="{Binding IsChecked}" Focusable="False" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="6,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="#666" VerticalAlignment="Center" />
                <!-- 追加インポートだけ: 取り込み後の名前・取り込み方（同名のカテゴリがある場合は追加か置き換えを選ぶ） -->
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="6,3,0,0"
                            Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox Width="190" SelectedIndex="{Binding ModeIndex}" Margin="0,0,8,0"
                              Visibility="{Binding HasSameName, Converter={StaticResource BoolToVisibility}}"
                              AutomationProperties.Name="{x:Static l:Strings.SelectModeLabel}">
                        <ComboBoxItem Content="{x:Static l:Strings.SelectModeAdd}" />
                        <ComboBoxItem Content="{x:Static l:Strings.SelectModeReplace}" />
                    </ComboBox>
                    <TextBlock Text="{Binding ResultText}" Foreground="#555" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock x:Name="PromptText" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBox x:Name="SearchBox" Padding="4,3" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                     AutomationProperties.Name="{x:Static l:Strings.SelectSearch}" />
            <TextBlock x:Name="SearchPlaceholder" Text="{x:Static l:Strings.SelectSearch}" Foreground="Gray"
                       Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
                <Button Content="{x:Static l:Strings.ButtonCancel}" IsCancel="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static l:Strings.SelectAllVisible}" Click="OnSelectAll" Margin="0,0,6,0" />
                <Button Content="{x:Static l:Strings.SelectNoneVisible}" Click="OnSelectNone" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="NoteText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#555" FontSize="12" TextWrapping="Wrap" />
        <Grid>
            <ListBox x:Name="List" Height="300" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewKeyDown="OnListKeyDown" AutomationProperties.Name="{Binding Text, ElementName=PromptText}" />
            <TextBlock x:Name="NoMatch" Text="{x:Static l:Strings.SelectNoMatch}" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</Window>
