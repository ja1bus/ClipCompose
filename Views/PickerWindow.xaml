<Window x:Class="ClipCompose.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ClipCompose.Core.Localization;assembly=ClipCompose.Core"
        xmlns:v="clr-namespace:ClipCompose.Views"
        Title="{x:Static l:Strings.PickerTitle}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="ToolWindow"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        FontFamily="{x:Static v:UiFont.Family}" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 選択中の行は、検索欄にフォーカスがあっても（一覧が非アクティブでも）はっきり見えるようにする。 -->
        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CCE4F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- カテゴリの見出し。▶／▼ の見出しをクリック・Enter・←→ で開閉する。件数はカテゴリの全テンプレートの数。 -->
        <DataTemplate DataType="{x:Type v:CategoryRow}">
            <Grid Margin="2,5,6,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{x:Static v:UiFont.Icons}" FontSize="9" Foreground="#666"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#444" Margin="2,0,6,0"
                           TextTrimming="CharacterEllipsis" Cursor="SizeNS" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" ToolTip="{Binding CountTip}" Foreground="#777" FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Expanded}" Value="False">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:TemplateRow}">
            <Grid x:Name="RowGrid" Margin="18,1,2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <!-- 検索結果（平らな一覧）では所属カテゴリを添える。行の高さは変えない。 -->
                <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Foreground="#888" FontSize="11.5" MaxWidth="104" Margin="6,0,2,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowCategory, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="2" Text="&#xE77F;" FontFamily="{x:Static v:UiFont.Icons}" FontSize="12" Foreground="#2E6DB4"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{x:Static l:Strings.UsesClipboard}"
                           Visibility="{Binding UsesClipboard, Converter={StaticResource BoolToVisibility}}" />
                <!-- 固定中の目印（設定画面の一覧と同じ）。固定・解除は下の［固定する］ボタンと Ctrl+P で行う。 -->
                <TextBlock Grid.Column="3" Text="&#xE840;" FontFamily="{x:Static v:UiFont.Icons}" FontSize="13" Foreground="#D9480F"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{x:Static l:Strings.PinnedMark}"
                           Visibility="{Binding Pinned, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowCategory}" Value="True">
                    <Setter TargetName="RowGrid" Property="Margin" Value="6,1,2,1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel x:Name="LeftPane" Width="284">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="SearchBox" Padding="4,3" VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                         AutomationProperties.Name="{x:Static l:Strings.PickerSearch}" />
                <TextBlock x:Name="SearchPlaceholder" Text="{x:Static l:Strings.PickerSearch}" Foreground="Gray"
                           Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal">
                    <!-- 選んでいるテンプレートを固定・解除する（設定画面の［テンプレート］タブと同じボタン）。 -->
                    <Button x:Name="PinButton" Click="OnTogglePin" Padding="6,2" Focusable="False" ToolTip="{x:Static l:Strings.ButtonPinTip}"
                            AutomationProperties.Name="{Binding Text, ElementName=PinText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE840;" FontFamily="{x:Static v:UiFont.Icons}" Foreground="#D9480F" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="PinText" Text="{x:Static l:Strings.ButtonPin}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PreviewButton" Click="OnTogglePreview" Padding="6,2" Margin="6,0,0,0" Focusable="False" ToolTip="{x:Static l:Strings.PickerPreviewTip}"
                            AutomationProperties.Name="{x:Static l:Strings.PickerPreview}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE890;" FontFamily="{x:Static v:UiFont.Icons}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{x:Static l:Strings.PickerPreview}" />
                        </StackPanel>
                    </Button>
                    <!-- すべて開く／すべて閉じる（検索中は使えない）。新しい行を増やさないよう、アイコンだけのボタンにする。 -->
                    <Button x:Name="FoldAllButton" Click="OnFoldAll" Padding="5,2" Margin="6,0,0,0" Focusable="False">
                        <TextBlock x:Name="FoldAllIcon" Text="&#xE70E;" FontFamily="{x:Static v:UiFont.Icons}" FontSize="11" VerticalAlignment="Center" />
                    </Button>
                    <Button Click="OnSettings" Padding="6,2" Margin="6,0,0,0" Focusable="False" ToolTip="{x:Static l:Strings.PickerSettingsTip}"
                            AutomationProperties.Name="{x:Static l:Strings.PickerSettings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{x:Static v:UiFont.Icons}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{x:Static l:Strings.PickerSettings}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- 自動貼り付け／コピーのみ。ボタンの行に置くと日本語で切れるため、次の行に置く。 -->
                <TextBlock x:Name="ModeText" Foreground="#555" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                <TextBlock Text="{x:Static l:Strings.PickerHint}" ToolTip="{x:Static l:Strings.PickerHintTip}" Foreground="#666" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <!-- 固定ホットキー（登録しているときだけ）。普段見る画面で思い出せるようにする。 -->
                <TextBlock x:Name="FixedHotkeyText" Foreground="#666" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="Collapsed" />

            </StackPanel>
            <Grid>
                <ListBox x:Name="List" MinHeight="140" ItemContainerStyle="{StaticResource ItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewMouseLeftButtonUp="OnListMouseUp"
                         SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop"
                         AutomationProperties.Name="{x:Static l:Strings.PickerTitle}" />
                <TextBlock x:Name="NoMatch" Text="{x:Static l:Strings.PickerNoMatch}" Foreground="Gray"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </DockPanel>

        <!-- 本文パネル。高さは左側に合わせ、本文の長さで画面を伸ばさない。 -->
        <Border x:Name="PreviewPane" Grid.Column="1" Width="360" Margin="8,0,0,0" Visibility="Collapsed"
                Height="{Binding ActualHeight, ElementName=LeftPane}" BorderBrush="#CCC" BorderThickness="1" Background="#FAFAFA">
            <DockPanel>
                <TextBlock x:Name="PreviewTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="8,6,8,4" TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="PreviewBox" IsReadOnly="True" IsTabStop="False" Focusable="False" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="4,0,4,6"
                         FontFamily="Consolas, Yu Gothic UI" FontSize="12.5"
                         AutomationProperties.Name="{x:Static l:Strings.PickerPreview}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
